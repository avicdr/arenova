{
  "name": "arenova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-favicons.mjs && node scripts/generate-html-templates.mjs && vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs && node scripts/validate-seo.mjs",
    "lint": "oxlint",
    "favicon:generate": "node scripts/generate-favicons.mjs",
    "templates:generate": "node scripts/generate-html-templates.mjs",
